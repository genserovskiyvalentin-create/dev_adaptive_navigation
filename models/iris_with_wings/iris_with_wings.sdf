    <!-- ============================================ -->
    <!-- КАМЕРА                                         -->
    <!-- ============================================ -->
    <link name="camera_link">
	<enable_wind>true</enable_wind> 
      <pose>0 0 0.10 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <pose>0 0 0.02 0 0 0</pose>
        <inertia>
          <ixx>0.00005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00005</iyy>
          <iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4</ambient>
          <diffuse>0.4 0.4 0.4</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="camera_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 -1.57 0</pose>
        <camera>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1024</width>
            <height>768</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>600</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <!-- <plugin filename="CameraZoomPlugin" name="CameraZoomPlugin"> -->
          <!-- <max_zooum>125.0</max_zoom> -->
          <!-- <slew_rate>0.42514285714</slew_rate> -->
        <!-- </plugin> -->
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
	
