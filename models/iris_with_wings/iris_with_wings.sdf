	    <!-- ArduPilot Plugin -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      
      <!-- Исправлено: Для Tailsitter (пули) оси координат модели ДОЛЖНЫ совпадать с самолетными (0 0 0) -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      
      <imuName>imu_link::imu_sensor</imuName>
      
      <!-- Канал 0 (SERVO1): Motor 1 (Передний Правый) -->
      <control channel="0">
        <jointName>rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>2400</multiplier> <!-- CCW (Против часовой) -->
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1990</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>10</cmd_max>
        <cmd_min>-10</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      
      <!-- Канал 1 (SERVO2): Motor 2 (Задний Левый) -->
      <control channel="1">
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>2400</multiplier> <!-- CCW (Против часовой) -->
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1990</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>10</cmd_max>
        <cmd_min>-10</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      
      <!-- Канал 2 (SERVO3): Motor 3 (Передний Левый) -->
      <control channel="2">
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-2400</multiplier> <!-- CW (По часовой) -->
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1990</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>10</cmd_max>
        <cmd_min>-10</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      
      <!-- Канал 3 (SERVO4): Motor 4 (Задний Правый) -->
      <control channel="3">
        <jointName>rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-2400</multiplier> <!-- CW (По часовой) -->
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1990</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>10</cmd_max>
        <cmd_min>-10</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
    </plugin>



<!-- ВЕТЕР: прикладываем силу напрямую к корпусу -->
    <plugin filename="gz-sim-apply-link-wrench-system" 
            name="gz::sim::systems::ApplyLinkWrench">
      <link_name>base_link</link_name>
    </plugin>

